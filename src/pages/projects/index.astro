---
import MainLayout from "../../layouts/MainLayout.astro";
import PortfolioRegistry from "../../components/sections/PortfolioRegistry.astro";
import ProjectFilter from "../../components/interactive/ProjectFilter.astro";
import SystemTerminal from "../../components/interactive/SystemTerminal.astro";
import { getSortedProjects } from "../../lib/content";

const projects = await getSortedProjects();
const terminalCommands = [
  {
    input: "neofetch",
    output: "Runtime: Static Portfolio\nHost: GitHub Pages\nBuild: Astro 7.3.4\nContent: MDX + Zod\nStyle: Tailwind CSS 4\nMode: Static Generation",
  },
  {
    input: "ls /projects",
    output: projects.map((project) => `${project.data.category.padEnd(22, " ")} ${project.id}`).join("\n"),
  },
];
---

<MainLayout
  title="Project Registry | Ryan Tran"
  description="A structured registry of Ryan Tran's documented systems, quantitative work and infrastructure projects."
>
  <main class="pt-24 min-h-screen bg-background">
    <header class="max-w-[1600px] mx-auto px-6 md:px-10 mb-8">
      <div class="border-b border-primary/20 pb-4">
        <p class="text-[10px] font-mono text-muted uppercase tracking-[0.3em]">Portfolio_Inventory</p>
        <h1 class="text-3xl md:text-5xl font-bold tracking-tighter uppercase">Project Registry</h1>
        <p class="mt-3 max-w-2xl text-sm text-muted leading-relaxed">
          Browse the documented systems by domain, stack and operational impact.
        </p>
        <div class="mt-6">
          <ProjectFilter />
        </div>
      </div>
    </header>

    <section class="max-w-[1600px] mx-auto px-6 md:px-10 mb-8" aria-labelledby="runtime-terminal-title">
      <div class="mb-3 flex items-center gap-2">
        <span class="w-6 h-px bg-primary"></span>
        <h2 id="runtime-terminal-title" class="text-[10px] font-mono font-bold uppercase tracking-[0.35em] text-primary">Portfolio_Runtime_Terminal</h2>
      </div>
      <SystemTerminal commands={terminalCommands} />
    </section>

    <PortfolioRegistry projects={projects} />
  </main>
</MainLayout>
