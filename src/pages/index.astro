---
import MainLayout from "../layouts/MainLayout.astro";
import Hero from "../components/sections/Hero.astro";
import AboutMe from "../components/sections/AboutMe.astro";
import IntelligenceHub from "../components/sections/IntelligenceHub.astro";
import ProjectShowcase from "../components/sections/ProjectShowcase.astro";
import FrameworksHub from "../components/FrameworksHub.astro";
import { getSortedProjects } from "../lib/content";

const projects = await getSortedProjects();
---

<MainLayout title="Ryan Tran | Command Center">
  <Hero />

  <!-- About Me Section -->
  <section id="about-me" class="min-h-screen flex items-center bg-background border-t border-border/30">
    <AboutMe />
  </section>

  <!-- Intelligence Hub Section (3D Graph & Metrics) -->
  <section id="intelligence-hub" class="min-h-screen flex items-center bg-background border-t border-border/30 overflow-hidden">
    <div class="w-full">
      <IntelligenceHub projects={projects} />
    </div>
  </section>

  <ProjectShowcase projects={projects} limit={6} />


  <!-- Governance & Frameworks Hub Section (hidden)
  <section id="frameworks-hub" class="min-h-screen flex items-center bg-background border-t border-border overflow-hidden">
    <FrameworksHub />
  </section>
  -->
</MainLayout>
