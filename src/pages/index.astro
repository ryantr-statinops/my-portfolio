---
import MainLayout from "../layouts/MainLayout.astro";
import Hero from "../components/sections/Hero.astro";
import AboutMe from "../components/sections/AboutMe.astro";
import StrategyHub from "../components/sections/StrategyHub.astro";
import ProjectShowcase from "../components/sections/ProjectShowcase.astro";
import { getSortedProjects } from "../lib/content";

const projects = await getSortedProjects();
---

<MainLayout title="Ryan Tran | Command Center" backgroundVideo>
  <Hero />

  <!-- About Me Section -->
  <section id="about-me" class="min-h-screen flex items-center bg-transparent border-t border-border/30">
    <AboutMe />
  </section>

  <StrategyHub />

  <ProjectShowcase projects={projects} limit={6} />
</MainLayout>
