---
interface Props {
  commands?: {
    input: string;
    output: string;
  }[];
}

const { commands = [
  { input: "neofetch", output: "Runtime: Static Portfolio\nHost: GitHub Pages\nBuild: Astro 7.3.4\nContent: MDX + Zod\nStyle: Tailwind CSS 4\nMode: Static Generation\nTheme: Minimal-Dark\nTerminal: Portfolio Runtime" },
  { input: "ls /projects", output: "finance-quant\nops-automation\ndata-math\nsystem-ui" }
] } = Astro.props;

const commandMap = Object.fromEntries(commands.map((command) => [command.input.toLowerCase(), command.output]));
---

<div data-terminal data-command-map={JSON.stringify(commandMap)} class="bg-black border border-border rounded-lg overflow-hidden font-mono text-[11px] shadow-2xl glass reveal">
  <!-- Terminal Header -->
  <div class="bg-white/5 px-4 py-2 flex items-center justify-between border-b border-border">
    <div class="flex gap-1.5">
      <div class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]"></div>
      <div class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]"></div>
      <div class="w-2.5 h-2.5 rounded-full bg-[#27c93f]"></div>
    </div>
    <span class="text-muted text-[10px] uppercase tracking-widest opacity-50">bash — 80x24</span>
  </div>

  <!-- Terminal Content -->
  <div data-terminal-output class="p-5 space-y-4 min-h-[300px] max-h-[420px] overflow-y-auto">
    {commands.map(cmd => (
      <div data-terminal-entry class="space-y-1">
        <div class="flex gap-2">
          <span class="text-success font-bold">➜</span>
          <span class="text-accent">~</span>
          <span class="text-white/90">{cmd.input}</span>
        </div>
        <pre class="text-muted whitespace-pre-wrap leading-relaxed">{cmd.output}</pre>
      </div>
    ))}
    <div class="flex gap-2">
      <span class="text-success font-bold">➜</span>
      <span class="text-accent">~</span>
      <span class="w-2 h-4 bg-primary animate-pulse"></span>
    </div>
  </div>

  <form data-terminal-form class="flex items-center gap-2 border-t border-border bg-white/5 px-4 py-3">
    <label for="terminal-command" class="sr-only">Enter a portfolio terminal command</label>
    <span class="text-success font-bold">➜</span>
    <input
      id="terminal-command"
      data-terminal-input
      type="text"
      autocomplete="off"
      spellcheck="false"
      placeholder="help"
      class="min-w-0 flex-1 bg-transparent text-white outline-none placeholder:text-muted"
    />
    <button type="submit" class="min-h-11 rounded border border-border px-3 text-[10px] font-bold uppercase tracking-widest text-muted hover:border-primary hover:text-primary">
      Run
    </button>
  </form>
</div>

<script>
  // @ts-nocheck - browser-only terminal controller
  import { parseTerminalCommand } from "../../lib/terminal";

  const terminal = document.querySelector("[data-terminal]");
  const output = terminal?.querySelector("[data-terminal-output]");
  const form = terminal?.querySelector("[data-terminal-form]");
  const input = terminal?.querySelector("[data-terminal-input]");
  const commandMap = JSON.parse(terminal?.dataset.commandMap ?? "{}");
  const history = [];
  let historyIndex = -1;

  if (terminal && output && form && input) {
    const appendEntry = (command, result) => {
      const entry = document.createElement("div");
      entry.className = "space-y-1";
      entry.innerHTML = `<div class="flex gap-2"><span class="text-success font-bold">➜</span><span class="text-white/90"></span></div><pre class="text-muted whitespace-pre-wrap leading-relaxed"></pre>`;
      const commandText = entry.querySelector("span:last-child");
      const resultText = entry.querySelector("pre");
      if (commandText) commandText.textContent = command;
      if (resultText) resultText.textContent = result;
      output.append(entry);
      output.scrollTop = output.scrollHeight;
    };

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const command = input.value.trim().toLowerCase();
      if (!command) return;
      history.unshift(command);
      historyIndex = -1;

      const parsed = parseTerminalCommand(command, commandMap);
      if (parsed.clear) {
        output.replaceChildren();
      } else {
        appendEntry(command, parsed.output);
      }

      input.value = "";
    });

    input.addEventListener("keydown", (event) => {
      if (event.key === "ArrowUp") {
        event.preventDefault();
        historyIndex = Math.min(historyIndex + 1, history.length - 1);
        input.value = history[historyIndex] ?? "";
      }
      if (event.key === "ArrowDown") {
        event.preventDefault();
        historyIndex = Math.max(historyIndex - 1, -1);
        input.value = historyIndex === -1 ? "" : history[historyIndex];
      }
    });
  }
</script>
