---
const videoSrc = `${import.meta.env.BASE_URL}/videos/black-hole.webm`;
const posterSrc = `${import.meta.env.BASE_URL}/images/black-hole-poster.jpg`;
---

<div data-video-background class="video-background fixed inset-0 z-0 pointer-events-none overflow-hidden" aria-hidden="true">
  <img
    data-video-poster
    src={posterSrc}
    alt=""
    class="background-media absolute inset-0 h-full w-full object-cover"
  />
  <video
    data-background-video
    class="background-media background-video absolute inset-0 h-full w-full object-cover"
    autoplay
    muted
    loop
    playsinline
    preload="none"
    poster={posterSrc}
    tabindex="-1"
  >
    <source src={videoSrc} type="video/webm" />
  </video>
</div>

<script>
  const video = document.querySelector<HTMLVideoElement>(".background-video");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  function syncVideoMotionPreference() {
    if (!video) return;
    if (reducedMotion.matches) {
      video.pause();
    } else {
      void video.play().catch(() => {
        // Keep the poster visible when autoplay is unavailable.
      });
    }
  }

  syncVideoMotionPreference();
  reducedMotion.addEventListener("change", syncVideoMotionPreference);
</script>

<style>
  .background-media {
    transform: translateX(2%) scale(1.08);
  }

  @media (max-width: 767px) {
    .background-media {
      transform: translateX(1%) scale(1.05);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .background-video {
      display: none;
    }
  }
</style>
