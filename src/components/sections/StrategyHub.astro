---
import { STRATEGY_TRACKS } from "../../lib/strategy";

const tracks = STRATEGY_TRACKS;
const stages = Object.keys(tracks[0]?.stages ?? {});
---

<section
  id="intelligence-hub"
  data-strategy
  class="min-h-screen flex items-center border-t border-border/30 bg-transparent px-6 py-20 md:px-12"
  aria-labelledby="strategy-title"
>
  <div class="mx-auto w-full max-w-7xl">
    <div class="mb-10 max-w-2xl">
      <p class="mb-3 text-[10px] font-mono uppercase tracking-[0.3em] text-muted">02 / Capabilities &amp; Approach</p>
      <h2 id="strategy-title" class="text-4xl font-bold uppercase leading-tight tracking-tighter md:text-6xl">
        Capabilities &amp;<br /><span class="text-primary">Approach.</span>
      </h2>
      <p class="mt-4 max-w-xl text-sm leading-relaxed text-muted">
        Explore a capability and follow the process from framing a problem to building a solution.
      </p>
    </div>

    <div class="mb-8 grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-4" role="group" aria-label="Choose a capability">
      {tracks.map((track, index) => (
        <button
          type="button"
          data-strategy-domain={track.id}
          aria-pressed={index === 0 ? "true" : "false"}
          hidden
          class="min-h-11 rounded border border-border bg-background/35 px-4 py-3 text-left font-mono text-xs text-foreground backdrop-blur-md transition-colors hover:border-primary aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-background"
        >
          <span class="mr-2 opacity-60">0{index + 1}</span>{track.title}
        </button>
      ))}
    </div>

    <div class="grid gap-8 rounded-xl border border-border/60 bg-background/30 p-5 backdrop-blur-md md:p-7 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.4fr)] lg:gap-12">
      <div class="flex flex-col justify-between gap-8 border-t border-border pt-6 lg:border-t-0 lg:border-r lg:pr-10 lg:pt-0">
        <div>
          <p class="text-[10px] font-mono uppercase tracking-[0.25em] text-muted">Selected capability</p>
          <h3 data-strategy-title class="mt-3 text-2xl font-bold tracking-tight">{tracks[0]?.title}</h3>
          <p data-strategy-description class="mt-3 hidden text-sm leading-relaxed text-muted"></p>
        </div>
        <p data-strategy-status class="text-xs font-mono text-muted" aria-live="polite">
          Frame content is being prepared.
        </p>
      </div>

      <div>
        <div class="grid grid-cols-3 gap-2" role="group" aria-label="Approach stages">
          {stages.map((stage, index) => (
            <button
              type="button"
              data-strategy-stage={stage}
              aria-pressed={index === 0 ? "true" : "false"}
              hidden
              class="min-h-11 rounded-t border-b-2 border-border bg-background/25 px-2 py-3 text-left font-mono text-xs uppercase text-foreground backdrop-blur-md transition-colors hover:text-primary aria-pressed:border-primary aria-pressed:text-foreground"
            >
              <span class="mr-1 opacity-60">0{index + 1}</span>{stage}
            </button>
          ))}
        </div>

        <article data-strategy-panel class="pt-8" aria-live="polite" aria-atomic="true">
          <p data-stage-label class="text-[10px] font-mono uppercase tracking-[0.25em] text-muted">Frame</p>
          <h3 data-stage-title class="mt-3 hidden text-2xl font-bold tracking-tight"></h3>
          <p data-stage-description class="mt-3 text-sm leading-relaxed text-muted">
            Content is being prepared.
          </p>
          <div data-decision class="mt-8 hidden border-t border-border pt-5">
            <p class="text-[10px] font-mono uppercase tracking-[0.2em] text-muted">Decision</p>
            <h4 data-decision-title class="mt-2 text-lg font-semibold"></h4>
            <p data-decision-rationale class="mt-2 text-sm leading-relaxed text-muted"></p>
            <details data-tradeoff class="mt-4 hidden">
              <summary class="min-h-11 cursor-pointer py-3 text-xs font-mono text-foreground">Explore the trade-off</summary>
              <div class="grid gap-4 border-l border-border pl-4 sm:grid-cols-2">
                <div data-benefit class="hidden">
                  <p class="text-[10px] font-mono uppercase text-muted">Benefit</p>
                  <p data-benefit-copy class="mt-1 text-sm leading-relaxed"></p>
                </div>
                <div data-tradeoff-copy-wrap class="hidden">
                  <p class="text-[10px] font-mono uppercase text-muted">Trade-off</p>
                  <p data-tradeoff-copy class="mt-1 text-sm leading-relaxed"></p>
                </div>
              </div>
            </details>
          </div>
          <a data-related-project class="mt-8 hidden min-h-11 items-center border-t border-border pt-5 text-sm text-primary hover:text-foreground"></a>
        </article>
      </div>
    </div>
  </div>
</section>

<script>
  import { STRATEGY_STAGES, STRATEGY_TRACKS } from "../../lib/strategy";
  import { getBaseUrl } from "../../lib/utils";

  const root = document.querySelector<HTMLElement>("[data-strategy]");

  if (root) {
    const domainButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-strategy-domain]")];
    const stageButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-strategy-stage]")];
    const title = root.querySelector<HTMLElement>("[data-strategy-title]");
    const description = root.querySelector<HTMLElement>("[data-strategy-description]");
    const status = root.querySelector<HTMLElement>("[data-strategy-status]");
    const stageLabel = root.querySelector<HTMLElement>("[data-stage-label]");
    const stageTitle = root.querySelector<HTMLElement>("[data-stage-title]");
    const stageDescription = root.querySelector<HTMLElement>("[data-stage-description]");
    const decision = root.querySelector<HTMLElement>("[data-decision]");
    const decisionTitle = root.querySelector<HTMLElement>("[data-decision-title]");
    const decisionRationale = root.querySelector<HTMLElement>("[data-decision-rationale]");
    const tradeoff = root.querySelector<HTMLDetailsElement>("[data-tradeoff]");
    const benefit = root.querySelector<HTMLElement>("[data-benefit]");
    const benefitCopy = root.querySelector<HTMLElement>("[data-benefit-copy]");
    const tradeoffCopyWrap = root.querySelector<HTMLElement>("[data-tradeoff-copy-wrap]");
    const tradeoffCopy = root.querySelector<HTMLElement>("[data-tradeoff-copy]");
    const relatedProject = root.querySelector<HTMLAnchorElement>("[data-related-project]");

    const state: { domainId: string; stage: (typeof STRATEGY_STAGES)[number] } = {
      domainId: STRATEGY_TRACKS[0]?.id ?? "",
      stage: STRATEGY_STAGES[0],
    };

    function updateText(element: HTMLElement | null, value: string) {
      if (!element) return;
      element.textContent = value;
      element.hidden = value.trim().length === 0;
    }

    function render() {
      const track = STRATEGY_TRACKS.find((item) => item.id === state.domainId) ?? STRATEGY_TRACKS[0];
      const content = track?.stages[state.stage];
      if (!track || !content) return;

      domainButtons.forEach((button) => {
        button.setAttribute("aria-pressed", String(button.dataset.strategyDomain === track.id));
      });
      stageButtons.forEach((button) => {
        button.setAttribute("aria-pressed", String(button.dataset.strategyStage === state.stage));
      });

      updateText(title, track.title);
      updateText(description, track.description);
      updateText(stageLabel, content.label);
      updateText(stageTitle, content.title);
      updateText(stageDescription, content.description || "Content is being prepared.");
      updateText(decisionTitle, content.decision);
      updateText(decisionRationale, content.rationale);

      const hasDecision = Boolean(content.decision || content.rationale || content.benefit || content.tradeoff);
      if (decision) decision.hidden = !hasDecision;
      if (tradeoff) {
        tradeoff.hidden = !content.benefit && !content.tradeoff;
        tradeoff.open = false;
      }
      if (benefit) benefit.hidden = !content.benefit;
      updateText(benefitCopy, content.benefit);
      if (tradeoffCopyWrap) tradeoffCopyWrap.hidden = !content.tradeoff;
      updateText(tradeoffCopy, content.tradeoff);

      if (relatedProject) {
        if (content.relatedProject) {
          relatedProject.href = getBaseUrl(`/projects/${content.relatedProject}`);
          relatedProject.textContent = `Explore ${content.relatedProject}`;
          relatedProject.hidden = false;
        } else {
          relatedProject.removeAttribute("href");
          relatedProject.textContent = "";
          relatedProject.hidden = true;
        }
      }

      if (status) status.textContent = `${content.label} content is being prepared.`;
    }

    domainButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const domainId = button.dataset.strategyDomain;
        if (!domainId || !STRATEGY_TRACKS.some((track) => track.id === domainId)) return;
        state.domainId = domainId;
        state.stage = STRATEGY_STAGES[0];
        render();
      });
    });

    stageButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const stage = button.dataset.strategyStage as (typeof STRATEGY_STAGES)[number] | undefined;
        if (!stage || !STRATEGY_STAGES.includes(stage)) return;
        state.stage = stage;
        render();
      });
    });

    render();
    root.querySelectorAll<HTMLButtonElement>("[data-strategy-domain], [data-strategy-stage]").forEach((button) => {
      button.hidden = false;
    });
    root.dataset.strategyReady = "true";
  }
</script>
