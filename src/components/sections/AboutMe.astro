---
const journey = [
  { step: 'Statistics', desc: 'Applied statistics — quantitative thinking as the base layer.' },
  { step: 'Data', desc: 'Data systems, pipelines and databases.' },
  { step: 'Software', desc: 'Backend engineering — Python, FastAPI, Go.' },
  { step: 'Systems', desc: 'Infrastructure and self-hosted clusters — Linux, Docker, networking.' },
  { step: 'Operations', desc: 'Reliable, observable systems that run themselves.' },
];

const corePrinciples = [
  { title: 'Systems over Tools', desc: 'Isolated tools decay. Connected systems compound.' },
  { title: 'Data-driven Action', desc: 'Data only matters when it creates movement.' },
  { title: 'Minimalist by Default', desc: 'Complexity is easy. Simplicity takes discipline.' },
];
---

<section class="w-full min-h-screen flex items-center py-10 px-8 md:px-12 bg-background relative overflow-hidden">
  <!-- Decorative background elements -->
  <div class="absolute top-0 left-0 w-full h-full opacity-20 pointer-events-none">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-primary/10 rounded-full blur-[100px] animate-pulse"></div>
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-accent/10 rounded-full blur-[100px] animate-pulse" style="animation-delay: 2s"></div>
  </div>

  <div class="max-w-7xl mx-auto grid grid-cols-12 gap-10 relative z-10 w-full">
    <!-- Left: About Me Meta -->
    <div class="col-span-12 lg:col-span-5 flex flex-col justify-center space-y-6 reveal">

      <h2 class="text-5xl md:text-6xl font-bold tracking-tighter text-foreground leading-[0.9] uppercase">
        I turn data <br />
        into <span class="text-primary italic">systems</span> that <br />
        run themselves.
      </h2>

      <div class="space-y-4 text-muted leading-relaxed text-base font-medium border-l border-border pl-6">
        <p>
          Applied Statistics student building <span class="text-foreground font-bold">self-operating architectures</span> — from data pipelines to self-hosted clusters to AI-native tooling.
        </p>
        <p class="text-sm opacity-80 leading-relaxed">
          Everything here is real. Every project runs on production hardware, not slides.
        </p>
      </div>

      <div class="p-5 bg-foreground/[0.04] border border-border/80 rounded-2xl glass-premium">
        <p class="text-xs italic leading-relaxed text-muted font-mono uppercase tracking-tight">
          "Intelligence is the ability to <span class="text-primary font-bold">Predict</span> and <span class="text-primary font-bold">Self-Adjust</span>."
        </p>
      </div>
    </div>

    <!-- Right: Journey Timeline + Principles -->
    <div class="col-span-12 lg:col-span-7 flex flex-col justify-center gap-8 reveal">

      <!-- Journey Chain -->
      <div class="space-y-1">
        <h4 class="text-[9px] font-mono text-muted uppercase tracking-[0.35em] mb-4">Journey</h4>
        <div class="space-y-0">
          {journey.map((step, i) => (
            <div class="flex items-start gap-4 group">
              <div class="flex flex-col items-center">
                <span class="w-3 h-3 rounded-full bg-primary/30 border border-primary/60 group-hover:bg-primary transition-colors mt-1"></span>
                {i < journey.length - 1 && <span class="w-px flex-1 bg-border/60 min-h-6"></span>}
              </div>
              <div class="pb-5">
                <h5 class="text-base font-bold uppercase tracking-tight text-foreground group-hover:text-primary transition-colors">{step.step}</h5>
                <p class="text-xs text-muted leading-relaxed">{step.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Principles -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        {corePrinciples.map((p, i) => (
          <div class="p-5 rounded-3xl border border-border/80 bg-card/30 glass-premium hover:border-primary/50 transition-all duration-500 group">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-[9px] font-mono text-primary bg-primary/10 px-2 py-0.5 rounded">0{i+1}</span>
              <h5 class="text-sm font-bold uppercase tracking-tight group-hover:text-primary transition-colors">{p.title}</h5>
            </div>
            <p class="text-xs text-muted leading-relaxed group-hover:text-foreground/80 transition-colors">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
