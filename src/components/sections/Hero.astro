---
import HeatmapBackground from "../interactive/HeatmapBackground.astro";
---

<section class="min-h-screen flex items-center pt-20 pb-20 px-8 md:px-12 w-full relative overflow-hidden bg-background">
  <HeatmapBackground />

  <div class="relative z-10 max-w-5xl w-full">
    <div class="space-y-10">
      <div class="space-y-4 reveal">
        <h1 class="text-6xl md:text-8xl font-bold leading-[0.9] tracking-tighter uppercase">
          SYSTEMS. <br />
          OPERATIONS. <br />
          <span class="text-gradient">INFRASTRUCTURE.</span>
        </h1>
        <p class="text-muted text-xl md:text-2xl max-w-2xl font-medium leading-relaxed">
          An Math - Statistics student building <br />
          <span class="text-primary italic font-semibold">software</span>, <span class="text-primary italic font-semibold">data systems</span>, and <span class="text-primary italic font-semibold">infrastructure</span> <br />
          across <span class="text-gradient">quantitative research</span> and <span class="text-primary italic font-semibold">AI-native</span> tooling.
        </p>
      </div>

      <!-- Current Focus — Bento (Option 2) -->
      <div class="space-y-2 reveal">
        <div class="flex items-center gap-2">
          <span class="text-[16px] font-bold tracking-tighter uppercase text-primary">CURRENT FOCUS</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          {[
            { title: "Backend Engineering", desc: "Python, FastAPI, Go, Traefik, APIs & system architecture" },
            { title: "Data Engineering", desc: "data pipelines, databases & data infrastructure" },
            { title: "Infrastructure", desc: "Linux, Docker, networking & service orchestration" },
            { title: "AI Infrastructure", desc: "MCP, agents, harnesses, model routing & developer tooling" },
            { title: "Quantitative Analytics", desc: "statistical modeling, quantitative research & trading systems" },
            { title: "Statistics → Engineering", desc: "applying quantitative thinking to software systems" },
          ].map(item => (
            <div class="p-4 bg-foreground/[0.03] border border-border rounded-xl glass flex flex-col gap-1.5 hover:border-primary/30 transition-colors">
              <span class="text-[10px] font-mono font-bold text-foreground uppercase tracking-widest">{item.title}</span>
              <span class="text-xs font-mono text-muted leading-relaxed">{item.desc}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- CTA — with header like CURRENT FOCUS -->
      <div class="space-y-2 pt-2 reveal">
        <div class="flex items-center gap-2">
          <span class="text-[16px] font-bold tracking-tighter uppercase text-primary">EXPLORE</span>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="#about-me" class="inline-flex items-center justify-center px-6 py-3 bg-foreground/[0.03] border border-border text-foreground font-mono font-black uppercase tracking-[0.2em] text-xs rounded-xl glass transition-colors hover:bg-white hover:text-black hover:border-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
            VIEW PROFILE
          </a>
          <a href="#projects" class="inline-flex items-center justify-center px-6 py-3 bg-foreground/[0.03] border border-border text-foreground font-mono font-black uppercase tracking-[0.2em] text-xs rounded-xl glass transition-colors hover:bg-white hover:text-black hover:border-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
            VIEW PROJECTS
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .text-gradient {
    background: linear-gradient(to right, #00f2ff, #0ea5e9, #93f8d8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
</style>
