---
import ProjectCard from "../ProjectCard.astro";
import type { ProjectEntry } from "../../lib/content";

interface Props {
  projects: ProjectEntry[];
  limit?: number;
}

const { projects = [], limit = 6 } = Astro.props as Props;
const visible = projects.slice(0, limit);
---

<section id="projects" class="min-h-screen flex items-center py-20 bg-background/50 border-y border-border px-8 md:px-12 reveal">
  <div class="max-w-7xl mx-auto w-full">
    <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6">
      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <div class="w-8 h-px bg-primary/50"></div>
          <span class="text-[10px] font-mono text-primary uppercase tracking-[0.4em]">Audit_Asset_Log</span>
        </div>
        <h2 class="text-5xl md:text-7xl font-bold tracking-tighter uppercase leading-none">PROJECT. <br/><span class="text-primary">REGISTRY_</span></h2>
      </div>
      <div class="flex items-center gap-3">
         <span class="px-4 py-2 bg-foreground/5 border border-border rounded text-[9px] font-mono text-muted uppercase tracking-widest">Index: BY_PRIORITY</span>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {visible.map(project => (
        <ProjectCard project={project} />
      ))}
    </div>

    {projects.length > 3 && (
      <div class="mt-12 flex justify-center">
        <a href={import.meta.env.BASE_URL + '/projects'} class="text-[10px] font-mono text-muted hover:text-primary transition-colors uppercase tracking-[0.4em] border-b border-border hover:border-primary pb-1">
          [ VIEW_FULL_INVENTORY_{projects.length}_ASSETS ]
        </a>
      </div>
    )}
  </div>
</section>
