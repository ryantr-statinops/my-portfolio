---
import { NAV_ITEMS } from "./Navbar.types";
import ThemeToggle from "../ui/ThemeToggle.astro";
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[60] focus:px-3 focus:py-1 focus:bg-foreground focus:text-background focus:rounded-full"
>
  Skip to content
</a>

<div class="fixed top-0 left-0 w-full z-50 px-4 pt-3 pointer-events-none">
  <nav
    aria-label="Primary"
    class="pointer-events-auto mx-auto max-w-fit flex items-center gap-1 rounded-full glass backdrop-blur-2xl bg-card/30 border border-border/60 shadow-lg shadow-black/5 pl-2 pr-1 py-1"
  >
    <a
      href={import.meta.env.BASE_URL}
      class="flex items-center justify-center w-9 h-9 rounded-full overflow-hidden bg-muted/10 border border-border/60 hover:scale-105 transition-transform"
      aria-label="Ryan Tran — Home"
    >
      <img
        src={import.meta.env.BASE_URL + "/images/avt.png"}
        alt=""
        class="w-full h-full object-cover"
        width="36"
        height="36"
      />
    </a>

    <div class="hidden md:flex items-center divide-x divide-border/50">
      {NAV_ITEMS.map((item) => (
        <a
          href={item.href}
          data-nav-section={item.sectionId}
          class="px-4 py-2 text-[13px] font-sans font-medium text-foreground hover:text-primary transition-colors data-[active=true]:text-primary data-[active=true]:bg-foreground/5 rounded-full"
        >
          {item.label}
        </a>
      ))}
    </div>

    <div class="hidden md:block pl-2 ml-1 border-l border-border/50">
      <ThemeToggle />
    </div>

    <button
      type="button"
      data-mobile-open
      class="md:hidden inline-flex items-center justify-center w-9 h-9 rounded-full text-foreground hover:text-primary"
      aria-label="Open menu"
      aria-controls="mobile-nav-overlay"
      aria-expanded="false"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" y1="6" x2="20" y2="6" />
        <line x1="4" y1="12" x2="20" y2="12" />
        <line x1="4" y1="18" x2="20" y2="18" />
      </svg>
    </button>
  </nav>
</div>
