---
import { NAV_ITEMS } from "./Navbar.types";
import ThemeToggle from "../ui/ThemeToggle.astro";
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[60] focus:px-3 focus:py-1 focus:bg-foreground focus:text-background focus:rounded"
>
  Skip to content
</a>

<nav
  aria-label="Primary"
  class="fixed top-0 left-0 w-full z-50 glass border-b border-border py-4 px-8 md:px-12"
>
  <div class="w-full flex justify-between items-center">
    <a
      href={import.meta.env.BASE_URL}
      class="flex items-center gap-3 hover:opacity-80 transition-opacity"
      aria-label="Ryan Tran — Home"
    >
      <div class="w-10 h-10 rounded-full overflow-hidden bg-muted/10 p-0.5 border border-border">
        <img
          src={import.meta.env.BASE_URL + "/images/avt.png"}
          alt=""
          class="w-full h-full object-cover rounded-full"
          width="40"
          height="40"
        />
      </div>
      <span class="font-semibold text-lg tracking-tight hidden sm:inline text-foreground">
        Ryan Tran
      </span>
    </a>

    <div class="flex items-center gap-4 md:gap-8 text-[11px] font-mono uppercase tracking-widest font-bold">
      <div class="hidden md:flex items-center gap-6">
        {NAV_ITEMS.map((item) => (
          <a
            href={item.href}
            data-nav-section={item.sectionId}
            class="hover:text-primary transition-colors"
          >
            [ {item.label} ]
          </a>
        ))}
      </div>
      <div class="pl-4 border-l border-border hidden md:block">
        <ThemeToggle />
      </div>
      <button
        type="button"
        data-mobile-open
        class="md:hidden inline-flex items-center justify-center w-10 h-10 rounded-lg border border-border text-foreground hover:text-primary"
        aria-label="Open menu"
        aria-controls="mobile-nav-overlay"
        aria-expanded="false"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" y1="6" x2="20" y2="6" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="18" x2="20" y2="18" />
        </svg>
      </button>
    </div>
  </div>
</nav>
