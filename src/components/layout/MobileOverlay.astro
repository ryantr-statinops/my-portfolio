---
import { NAV_ITEMS } from "./Navbar.types";
---

<div
  id="mobile-nav-overlay"
  data-open="false"
  class="fixed inset-0 z-40 hidden flex-col bg-background/95 backdrop-blur-xl transition-opacity"
  aria-hidden="true"
>
  <div class="flex-1 flex flex-col items-center justify-center gap-8 p-8">
    {NAV_ITEMS.map((item) => (
      <a
        href={item.href}
        data-mobile-link={item.sectionId}
        class="font-mono uppercase tracking-widest text-2xl font-bold text-foreground hover:text-primary transition-colors"
      >
        [ {item.label} ]
      </a>
    ))}
  </div>
  <button
    type="button"
    data-mobile-close
    class="absolute top-4 right-4 w-10 h-10 inline-flex items-center justify-center rounded-lg border border-border text-foreground hover:text-primary"
    aria-label="Close menu"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M18 6 6 18" />
      <path d="m6 6 12 12" />
    </svg>
  </button>
</div>

<script>
  const overlay = document.getElementById("mobile-nav-overlay");
  const openers = document.querySelectorAll<HTMLElement>("[data-mobile-open]");
  const closers = document.querySelectorAll<HTMLElement>("[data-mobile-close]");

  function setOpen(open: boolean) {
    if (!overlay) return;
    overlay.dataset.open = String(open);
    overlay.setAttribute("aria-hidden", String(!open));
    if (open) {
      overlay.classList.remove("hidden");
      overlay.classList.add("flex");
      document.documentElement.classList.add("overflow-hidden");
      const firstLink = overlay.querySelector<HTMLElement>("a");
      firstLink?.focus();
    } else {
      overlay.classList.add("hidden");
      overlay.classList.remove("flex");
      document.documentElement.classList.remove("overflow-hidden");
    }
  }

  openers.forEach((btn) => btn.addEventListener("click", () => setOpen(true)));
  closers.forEach((btn) => btn.addEventListener("click", () => setOpen(false)));

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && overlay?.dataset.open === "true") {
      setOpen(false);
    }
  });

  document.querySelectorAll<HTMLAnchorElement>("[data-mobile-link]").forEach((a) => {
    a.addEventListener("click", () => setOpen(false));
  });
</script>
