{
  "name": "my-portfolio",
  "type": "module",
  "version": "0.1.0",
  "description": "Ryan Tran — Command Center Portfolio (Astro + Tailwind + MDX)",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check --minimumSeverity error",
    "test": "npm run test:unit && npm run test:smoke && npm run test:visual",
    "test:unit": "vitest run",
    "test:smoke": "playwright test tests/e2e/smoke.spec.ts",
    "test:visual": "playwright test tests/e2e/visual.spec.ts",
    "test:watch": "vitest",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^7.3.4",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "gray-matter": "^4.0.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
