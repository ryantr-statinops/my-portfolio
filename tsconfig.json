{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "rootDirs": [".", ".react-router/types"]
  },
  "include": [".react-router/types/**/*", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "build", "dist"]
}
